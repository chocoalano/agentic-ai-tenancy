{
  "name": "agentic-ai-virtual-office",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun nuxt dev",
    "build": "bun --bun nuxt build",
    "preview": "bun --env-file=.env .output/server/index.mjs",
    "start": "bun .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.backend.json",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/unit tests/integration tests/security",
    "test:unit": "bun test tests/unit",
    "test:nuxt": "vitest run",
    "test:e2e": "bun test tests/e2e",
    "test:all": "bun run test && bun run test:nuxt && bun run test:e2e",
    "db:bootstrap": "bun scripts/db-bootstrap.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:migrate:test": "bun scripts/db-migrate.ts --test",
    "db:seed": "bun db/seeds/development.ts",
    "db:reset": "bun scripts/db-drop.ts && bun scripts/db-bootstrap.ts && bun scripts/db-migrate.ts",
    "api:standalone": "bun api/standalone.ts",
    "check:assets": "bun scripts/check-game-assets.ts",
    "assets:v2": "bun scripts/build-game-assets-v2.ts",
    "assets:audit": "bun scripts/audit-game-assets.ts",
    "assets:geometry": "bun scripts/calibrate-island-geometry.ts"
  },
  "dependencies": {
    "@elysia/openapi": "~1.4.16",
    "@elysiajs/eden": "~1.4.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lucide/vue": "^1.55.0",
    "@sinclair/typebox": "^0.34.52",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "~1.4.30",
    "nuxt": "^4.6.1",
    "openapi-types": "^12.1.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "nuxt-elysia": "1.0.0-beta.1",
    "prettier": "^3.9.10",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  },
  "version": "0.1.0",
  "description": "Agentic AI Virtual Office — fondasi Phase 1 (Nuxt 4 + ElysiaJS + Bun + PostgreSQL RLS)",
  "engines": {
    "bun": ">=1.3.0"
  }
}
