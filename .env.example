# =============================================================================
# Agentic AI Virtual Office — contoh konfigurasi environment
# Salin menjadi .env lalu ganti SEMUA nilai contoh. Jangan commit .env.
# Cara membuat secret: lihat docs/setup.md (bagian "Membuat secret").
# =============================================================================

NODE_ENV=development

# Nilai publik (boleh terlihat di browser).
NUXT_PUBLIC_APP_NAME="Agentic AI Virtual Office"

# --- Database ---------------------------------------------------------------
# Role RUNTIME aplikasi: NOSUPERUSER, NOBYPASSRLS, bukan pemilik tabel.
DATABASE_URL=postgresql://agentic_app:ganti-password-app@localhost:5432/agentic_office
# Role PEMILIK skema: hanya untuk migrasi (bun run db:migrate). Wajib berbeda dari DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://agentic_owner:ganti-password-owner@localhost:5432/agentic_office
# Role admin/superuser: HANYA untuk bun run db:bootstrap dan db:reset di lokal. Kosongkan di production.
DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/postgres

# Opsional (default ditampilkan)
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10

# --- Database test (dibutuhkan test integrasi, keamanan, e2e) ----------------
TEST_DATABASE_URL=postgresql://agentic_app:ganti-password-app@localhost:5432/agentic_office_test
TEST_DATABASE_MIGRATION_URL=postgresql://agentic_owner:ganti-password-owner@localhost:5432/agentic_office_test

# --- Sesi -------------------------------------------------------------------
# Minimal 32 karakter acak. Nilai contoh ini DITOLAK saat startup.
SESSION_SECRET=replace-with-strong-random-secret
# SESSION_TTL_HOURS=168
# Hanya berlaku di non-production; production selalu Secure + prefix __Host-.
# SESSION_COOKIE_SECURE=false

# --- Keamanan ---------------------------------------------------------------
# Origin tambahan yang dipercaya untuk request mutasi (dipisah koma), mis. bila
# frontend dilayani dari domain lain. Origin yang sama dengan Host selalu diizinkan.
# APP_TRUSTED_ORIGINS=https://office.example.com
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_WINDOW_MINUTES=15

# --- Pembatasan laju (in-memory per proses; fixed window) ----------------------
# Percobaan masuk per IP apa pun emailnya (menahan password spraying), registrasi per IP,
# pembuatan perusahaan per pengguna. Per-email tetap AUTH_LOGIN_MAX_FAILURES/WINDOW di atas.
# RATE_LIMIT_LOGIN_IP_MAX=30
# RATE_LIMIT_LOGIN_IP_WINDOW_MINUTES=15
# RATE_LIMIT_REGISTER_IP_MAX=10
# RATE_LIMIT_REGISTER_IP_WINDOW_MINUTES=60
# RATE_LIMIT_TENANT_CREATE_MAX=10
# RATE_LIMIT_TENANT_CREATE_WINDOW_MINUTES=60
# IP klien dibaca dari soket. Setel true HANYA bila aplikasi di belakang reverse proxy yang
# menyetel X-Forwarded-For (jika tidak, klien dapat memalsukan IP untuk pembatasan laju).
# TRUSTED_PROXY=false
# Strict-Transport-Security hanya untuk lingkungan HTTPS (jangan di HTTP lokal).
# SECURITY_HSTS=false

# --- Lain-lain --------------------------------------------------------------
# Dokumentasi OpenAPI/Scalar: default aktif di development/test, MATI di production.
# OPENAPI_ENABLED=true
# Heartbeat SSE harus < idle timeout Bun.serve (default 10 detik); config menolak kombinasi yang memutus stream.
# REALTIME_HEARTBEAT_MS=5000
# NITRO_BUN_IDLE_TIMEOUT=10
# API_STANDALONE_PORT=4000
# Password akun seed pengembangan (bun run db:seed). Tidak pernah dipakai di production.
# SEED_DEFAULT_PASSWORD=VirtualOffice!2026

# --- AI Runtime (Phase 5; hanya server) --------------------------------------
# none (default: eksekusi nyata tidak tersedia, POST /v1/tasks → 409 RUNTIME_NOT_CONFIGURED),
# openai-compatible (provider dengan API Chat Completions kompatibel OpenAI, mis. DigitalOcean
# Gradient AI serverless inference), fixture (adapter deterministik untuk test/dev — DITOLAK di production).
# AI_RUNTIME_PROVIDER=none
# DigitalOcean Gradient AI serverless inference: base URL + model access key + slug model.
# AI_RUNTIME_BASE_URL=https://inference.do-ai.run/v1
# AI_RUNTIME_API_KEY=
# AI_RUNTIME_MODEL=llama3.3-70b-instruct
# AI_RUNTIME_TIMEOUT_SECONDS=120
# AI_RUNTIME_TEMPERATURE=0.2
# AI_MAX_INSTRUCTION_CHARS=4000
# AI_MAX_OUTPUT_CHARS=20000
# AI_MAX_OUTPUT_TOKENS=1024

# --- Worker eksekusi (bun run worker; atau AI_WORKER_INLINE=true di proses server) -------
# AI_WORKER_INLINE=false
# AI_WORKER_ID=
# AI_WORKER_CONCURRENCY=2
# AI_WORKER_POLL_MS=1000
# AI_RUN_LEASE_SECONDS=60
# AI_RUN_MAX_ATTEMPTS=3
# Pengaman kapasitas per tenant (bukan anggaran moneter): tugas aktif bersamaan & tugas per hari (UTC).
# AI_TENANT_MAX_ACTIVE_RUNS=3
# AI_TENANT_DAILY_RUN_LIMIT=100
# RATE_LIMIT_TASK_CREATE_MAX=30
# RATE_LIMIT_TASK_CREATE_WINDOW_MINUTES=15

# --- Persetujuan & realtime --------------------------------------------------------
# APPROVAL_TTL_HOURS=24
# APPROVAL_FORBID_SELF=false
# Validasi ulang otorisasi stream SSE (sesi/keanggotaan/izin) dan polling outbox dispatcher.
# REALTIME_REVALIDATE_MS=15000
# REALTIME_OUTBOX_POLL_MS=1000
# REALTIME_OUTBOX_RETENTION_HOURS=24
